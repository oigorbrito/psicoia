## Current treatment stage
{{ session_stage }}

## Client background
{% if client_info -%}
{% set info = client_info.static_traits or {} -%}
{% macro line(label, value) -%}
- {{ label }}: {{ value | default('Unknown', true) }}
{%- endmacro -%}
### Basic information
{{ line('Name', info.name) }}
{{ line('Age', info.age) }}
{{ line('Gender', info.gender) }}
{{ line('Occupation', info.occupation) }}
{{ line('Education', info.educational_background) }}
{{ line('Marital status', info.marital_status) }}
### Family and social relationships
{{ line('Family situation', info.family_status) }}
{{ line('Social situation', info.social_status) }}
### Physical and mental health
{{ line('Medical history', info.medical_history) }}
### Presenting concern and counseling goals
{{ line('Presenting concern', client_info.main_problem) }}
{{ line('Topic', client_info.topic) }}
{{ line('Core expectations', client_info.core_demands) }}
### Developmental experiences
{% if client_info.growth_experiences -%}
{% for exp in client_info.growth_experiences -%}
- {{ loop.index }}. {{ exp }}
{% endfor -%}
{% else -%}
- Unknown
{% endif %}
### Core conflict
{%- if client_info.core_conflict -%}
{% set s = client_info.core_conflict or {} %}
- Underlying wish: {{ s.wish | default('Unknown', true) }}
- Core fear: {{ s.fear | default('Unknown', true) }}
- Defensive goals:
  {%- if s.defense_goal %}
    {%- for a in s.defense_goal if a %}
  - {{ a }}
    {%- endfor %}
  {%- else %}
  - None recorded
  {% endif %}
{% else -%}
- Conflict: Unknown
{% endif %}
### Object relations
{%- if client_info.object_relations -%}
{%- for s in client_info.object_relations -%}
  {% if s.self_representation is defined %}
- Relationship {{ loop.index }}:
  - Self-representation: {{ s.self_representation | default('Unknown', true) }}
  - Object representation: {{ s.object_representation | default('Unknown', true) }}
  - Linking affect: {{ s.linking_affect | default('Unknown', true) }}
  {% else -%}
- Relationship {{ loop.index }}: {{ s }}
  {% endif -%}
{% endfor -%}
{% else -%}
- None recorded
{% endif %}
### Defensive response patterns
{%- if client_info.behavioral_response_patterns -%}
{%- for s in client_info.behavioral_response_patterns -%}
  {% if s.trigger_condition is defined %}
- Pattern {{ loop.index }}:
  - Trigger: {{ s.trigger_condition | default('Unknown', true) }}
  - Transference/projection: {{ s.interpretation | default('Unknown', true) }}
  - Defense: {{ s.defense_mechanism | default('Unknown', true) }}
  - Response guidance: {{ s.response_instruction | default('Unknown', true) }}
  {% else -%}
- Pattern {{ loop.index }}: {{ s }}
  {% endif -%}
{% endfor -%}
{% else -%}
- None recorded
{% endif -%}
{% else %}
(No client profile is available.)
{% endif %}

## Focus for this session
{% for focus in session_focus %}- {{ focus }}
{% endfor %}

## Previous sessions
{%- if history %}
{%- for session in history %}
### Session {{ loop.index }}
- Stage: {{ session.session_stage }}
- Summary: {{ session.session_summary_abstract }}
{%- if session.client_state_analysis %}
- Client state:
  - Affect: {{ session.client_state_analysis.affective_state }}
  - Unconscious manifestations: {{ session.client_state_analysis.subconscious_manifestation }}
  - Behavioral patterns: {{ session.client_state_analysis.behavioral_patterns }}
  - Therapeutic alliance: {{ session.client_state_analysis.therapeutic_alliance }}
  - Unresolved issues or tensions: {{ session.client_state_analysis.unresolved_points_or_tensions }}
{%- endif %}
{%- endfor %}
{%- else %}
(No previous session history.)
{%- endif %}

## Complete counseling conversation from this session
{{ current_session_dialogue }}
